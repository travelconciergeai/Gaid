# ============================================================================
# Voia — Variáveis de Ambiente
# ============================================================================

# Frontend (Vite — prefixo VITE_ obrigatório)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Serverless /api (definir no painel Vercel, NÃO no cliente)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Supabase — service role para o cérebro Voia (server-side only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Amadeus — voos e hotéis (https://developers.amadeus.com)
# Use test.api.amadeus.com em dev; AMADEUS_ENV=production em prod
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_ENV=test

# Google Places — passeios, restaurantes, geocoding
# https://console.cloud.google.com/apis/library/places.googleapis.com
GOOGLE_PLACES_API_KEY=

# RapidAPI — alternativa para TripAdvisor / atrações
# https://rapidapi.com/apidojo/api/travel-advisor
RAPIDAPI_KEY=

# Unsplash — capas automáticas (opcional, futuro)
UNSPLASH_ACCESS_KEY=
